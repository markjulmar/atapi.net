<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="Atapi" Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'AnyCPU'">
		  <HintPath>$(MSBuildThisFileDirectory)\..\build\x64\atapi.dll</HintPath>
    </Reference>
	 <Reference Include="Atapi" Condition="'$(Platform)' == 'x86'">
	   <HintPath>$(MSBuildThisFileDirectory)\..\build\x64\atapi.dll</HintPath>
   </Reference>
   <Reference Include="Atapi" Condition="'$(Platform)' == 'ARM64'">
     <HintPath>$(MSBuildThisFileDirectory)\..\build\ARM64\atapi.dll</HintPath>
   </Reference>
  </ItemGroup>
</Project>